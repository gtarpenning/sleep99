default_platform(:ios)

platform :ios do

  desc "Build and upload to TestFlight"
  # CI sets MATCH_KEYCHAIN_NAME=build.keychain and MATCH_KEYCHAIN_PASSWORD="".
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id:               ENV["ASC_KEY_ID"],
      issuer_id:            ENV["ASC_ISSUER_ID"],
      key_content:          ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house:             false
    )

    # Profiles + dist cert for the app and the widget extension (see Matchfile).
    match(
      type:              "appstore",
      readonly:          true,
      api_key:           api_key,
      keychain_name:     ENV.fetch("MATCH_KEYCHAIN_NAME", "login.keychain"),
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
    )

    # Bump and commit first so the signing edits below never end up in git.
    current_build = latest_testflight_build_number(
      api_key:        api_key,
      app_identifier: "com.sleep-tune.app"
    ) rescue 0
    increment_build_number(
      build_number: (current_build.to_i + 1).to_s,
      xcodeproj:    "SleepTune.xcodeproj"
    )
    commit_version_bump(
      message:   "chore: bump build number [skip ci]",
      xcodeproj: "SleepTune.xcodeproj",
      force:     true
    )

    profiles = {
      "com.sleep-tune.app"        => ENV["sigh_com.sleep-tune.app_appstore_profile-name"],
      "com.sleep-tune.app.widget" => ENV["sigh_com.sleep-tune.app.widget_appstore_profile-name"]
    }
    { "SleepTune" => "com.sleep-tune.app", "SleepTuneWidgetExtension" => "com.sleep-tune.app.widget" }.each do |target, bundle_id|
      update_code_signing_settings(
        path:                  "SleepTune.xcodeproj",
        targets:               [target],
        build_configurations:  ["Release"],
        use_automatic_signing: false,
        team_id:               "JL39GTJ62X",
        code_sign_identity:    "Apple Distribution",
        profile_name:          profiles[bundle_id],
        bundle_identifier:     bundle_id
      )
    end

    gym(
      scheme:           "SleepTune",
      project:          "SleepTune.xcodeproj",
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "./build_output",
      output_name:      "SleepTune.ipa",
      clean:            true,
      export_options: {
        method:               "app-store",
        teamID:               "JL39GTJ62X",
        provisioningProfiles: profiles,
        signingStyle:         "manual"
      }
    )

    pilot(
      api_key:                           api_key,
      app_identifier:                    "com.sleep-tune.app",
      ipa:                               "./build_output/SleepTune.ipa",
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("RELEASE_NOTES", "Automated build")
    )

    # Drop the manual-signing edits, then publish the bump commit.
    reset_git_repo(force: true, files: ["SleepTune.xcodeproj/project.pbxproj"])
    push_to_git_remote
  end

  desc "Bootstrap certs (run once, or re-run after adding capabilities/targets)"
  lane :bootstrap_certs do
    api_key = app_store_connect_api_key(
      key_id:               ENV["ASC_KEY_ID"],
      issuer_id:            ENV["ASC_ISSUER_ID"],
      key_content:          ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house:             false
    )

    # force: regenerate profiles so new capabilities (App Groups, iCloud) and
    # the widget bundle ID are picked up. Certificates are reused if valid.
    match(
      type:     "appstore",
      readonly: false,
      force:    true,
      api_key:  api_key
    )
  end

end
